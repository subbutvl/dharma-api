# App queries (Supabase "Transaction pooler" / port 6543 is fine)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# `prisma db push` / `prisma migrate` — use Direct connection (port 5432), NOT the 6543 pooler.
# Supabase → Project Settings → Database → Connection string → URI → switch to "Direct connection".
# Host looks like: db.[PROJECT-REF].supabase.co (user is `postgres` on this host).
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# If `db.*.supabase.co` is unreachable, use Session pooler (port 5432 on aws-*-*.pooler.supabase.com)
# with the SAME username style as DATABASE_URL (`postgres.[PROJECT-REF]`, not plain `postgres`):
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: protect POST /api/admin/* — browser UI stores token in localStorage and sends `x-admin-token`.
# ADMIN_TOKEN=your-long-random-secret

PORT=5000

# Optional: public bucket for deity images (Phase 8). Set when using Supabase Storage.
# SUPABASE_STORAGE_BUCKET=deity-images

