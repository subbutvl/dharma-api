generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Deity {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  title           String?
  description     String?
  descriptionEn   String?
  descriptionTa   String?
  category        String   @default("deva")
  aliases         String[] @default([])
  affiliation     String?
  abode           String?
  primaryImageUrl String?
  attributes      Json?
  relationships   Json?
  worship         Json?
  media           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slokas         Sloka[]
  temples        Temple[]
  avatars        Avatar[]
  songs          Song[]
  deityFestivals DeityFestival[]
}

model Sloka {
  id              String   @id @default(uuid())
  deityId         String
  deity           Deity    @relation(fields: [deityId], references: [id], onDelete: Cascade)
  title           String?
  sanskrit        String   @db.Text
  transliteration String?  @db.Text
  meaning         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deityId])
}

model Temple {
  id           String   @id @default(uuid())
  deityId      String
  deity        Deity    @relation(fields: [deityId], references: [id], onDelete: Cascade)
  name         String
  location     String
  significance String?  @db.Text
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([deityId])
}

model Avatar {
  id          String   @id @default(uuid())
  deityId     String
  deity       Deity    @relation(fields: [deityId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  tradition   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deityId])
}

model Song {
  id          String   @id @default(uuid())
  deityId     String?
  deity       Deity?   @relation(fields: [deityId], references: [id], onDelete: SetNull)
  title       String
  credit      String?
  externalUrl String
  licenseNote String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deityId])
}

model Festival {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  description String?           @db.Text
  deityLinks  DeityFestival[]
}

model DeityFestival {
  deityId    String
  festivalId String
  deity      Deity    @relation(fields: [deityId], references: [id], onDelete: Cascade)
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@id([deityId, festivalId])
}

model MythicalBeing {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  kind        String
  description String?  @db.Text
  lore        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
